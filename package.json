    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
